# Copy to .env and adjust. Only BETTER_AUTH_SECRET and ORIGIN are required in production.

# Public URL people use to reach openRun. Passkeys only work on this origin.
ORIGIN=http://localhost:3000

# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Name shown on the sign-in page.
INSTANCE_NAME=openRun

# How members can reach whoever runs this instance (shown before sign-up).
INSTANCE_CONTACT=

# The first account to sign up becomes the admin.
FIRST_USER_ADMIN=true

# Require an invite link to sign up (admins create invites in the app).
INVITE_ONLY=false

# Allow email + password sign-in. Passkeys are always available.
PASSWORD_LOGIN=true

# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Place search for club meeting points. Searches go from this server, so the
# geocoder sees the search text and the server's address, never members'.
# Defaults to OpenStreetMap's Nominatim (fair use: about one search a second).
# Point it at your own Nominatim, or leave it empty to turn search off.
# PLACE_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Weather for club runs. Only meeting point positions are sent.
# Leave empty to turn weather off.
# WEATHER_URL=https://api.open-meteo.com/v1/forecast

# intervals.icu, where members' watches sync to; openRun fetches their runs
# from it. Leave empty to turn watch sync off.
# INTERVALS_URL=https://intervals.icu

# Web Push keys for notifications. If unset, a pair is generated on first
# start and kept in DATA_DIR/vapid.json. Changing them means everyone has to
# turn notifications on again. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Optional overrides
# PORT=3000                       # with docker compose: the port on the host
# RP_ID=run.example.com            # WebAuthn relying party id, defaults to the ORIGIN hostname
# TRUSTED_ORIGINS=                 # extra allowed origins, comma separated
# DATA_DIR=/data                   # where the database and uploads live
# TZ=Europe/London
